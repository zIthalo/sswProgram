# Banco de dados do usuario -- NUNCA deve ser versionado. Ele contem dados
# reais de notas fiscais/clientes e, alem disso, se for commitado, um novo
# usuario que baixe o repositorio herdaria dados que nao sao dele.
*.db
*.db-journal
*.db-wal
*.db-shm

# Dados locais do usuario gerados pelo sistema (nunca versionar)
backups/
comprovantes/
exportacao_sac_*/
config_aparencia.json

# Saida do PyInstaller (gerada localmente a cada build, nao faz sentido
# versionar - quem precisa dos .exe pronto baixa pelo GitHub Releases)
build/
dist/
*.exe

# Cache do Python
__pycache__/
*.pyc
*.pyo

# Arquivos de editor/SO comuns
.vscode/
.idea/
Thumbs.db
.DS_Store
erros.log
erros.log.antigo
janela_principal.json
